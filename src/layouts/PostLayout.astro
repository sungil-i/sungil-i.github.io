---
// src/layouts/PostLayout.astro
import MainLayout from "./MainLayout.astro";

// Astro는 마크다운 렌더링 시 frontmatter와 headings 배열을 자동으로 props로 전달합니다.
const { frontmatter, headings } = Astro.props;

const tocHeadings = (headings ?? []).filter(
  (h: any) => h.depth >= 2 && h.depth <= 4,
);
---

<MainLayout title={frontmatter.title || "수업 기록"}>
  <div class="container-fluid max-w-none">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-11 col-xxl-10">
        <div class="mb-4">
          <a
            href="javascript:history.back()"
            class="text-decoration-none text-muted small"
          >
            <span class="me-1">←</span> 목록으로 돌아가기
          </a>
        </div>
        <div class="mb-5">
          <h1 class="fw-bold mb-3">{frontmatter.title}</h1>
          {
            frontmatter.date && (
              <div class="text-muted small">
                <span>📅 작성일: {frontmatter.date}</span>
              </div>
            )
          }
        </div>

        {
          tocHeadings.length > 0 && (
            <details id="toc" class="toc-details mb-4 p-3 rounded border">
              <summary
                class="fw-semibold"
                style="cursor:pointer; list-style:none; user-select:none;"
              >
                📑 목차
              </summary>
              <nav class="toc-nav mt-2">
                {tocHeadings.map((h: any) => (
                  <a
                    href={`#${h.slug}`}
                    class={`toc-link d-block text-decoration-none py-1 ${
                      h.depth === 2
                        ? "toc-h2"
                        : h.depth === 3
                          ? "toc-h3 ms-3"
                          : "toc-h4 ms-5"
                    }`}
                  >
                    {h.depth === 2 ? "▪ " : h.depth === 3 ? "◦ " : "· "}
                    {h.text}
                  </a>
                ))}
              </nav>
            </details>
          )
        }

        <div
          class="markdown-body shadow-sm p-4 p-md-5 rounded border w-100"
          style="max-width: 100%;"
        >
          <slot />
        </div>

        <div class="mt-5 text-center">
          <hr class="mb-5" />
          <a
            href="javascript:history.back()"
            class="btn btn-outline-dark px-4 rounded-pill"
          >
            목록으로 돌아가기
          </a>
        </div>
      </div>

      <!--
      <div class="d-none d-lg-block col-lg-2 col-xl-2 ps-lg-4" style="display:none;">
        <div class="sticky-top pt-2" style="top: 80px;">
          <h6
            class="fw-bold text-muted mb-3 text-uppercase"
            style="letter-spacing: 1px; font-size: 0.85rem;"
          >
            📝 Outline
          </h6>
          <nav class="nav flex-column outline-nav">
            {
              filteredHeadings.map((heading: any) => (
                <a
                  class={`nav-link text-muted py-1 ${heading.depth === 3 ? "ms-3 small" : "fw-semibold"}`}
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
      -->
    </div>
  </div>

  <a
    href="#toc"
    class="btn btn-primary rounded-circle shadow-lg btn-scroll-top svelte-1teoznn"
    aria-label="최상단으로 이동"
  >
    ↑<br /><span class="small" style="font-size: 0.7rem;">TOP</span>
  </a>
</MainLayout>

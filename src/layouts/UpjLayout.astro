---
// src/layouts/UpjLayout.astro
// 교사 전용 아카이브(src/pages/upj53) 전용 레이아웃입니다.
// 학생용 YearSelector/classEntries와는 완전히 분리된 별도 탐색 경로입니다.
import MainLayout from "./MainLayout.astro";

interface Props {
  frontmatter: {
    title: string;
  };
}

const { frontmatter } = Astro.props;

interface ArchivePost {
  url?: string;
  file?: string;
  frontmatter?: { title?: string; date?: string };
}

// 1. private 아카이브 하위의 모든 마크다운 문서를 즉시(eager) 로드합니다.
const pages = import.meta.glob("../pages/upj53/**/*.md", { eager: true });
const allPosts = Object.values(pages) as ArchivePost[];

// 2. 공개 수업 경로(YYYY/[classId]/daily)와 동일한 깊이를 갖는
//    src/pages/upj53/[classId]/daily/*.md 또는
//    src/pages/upj53/YYYY-[classId]/daily/*.md 구조에서 classId 그룹명을 추출합니다.
//    아카이브 진입 문서(upj53/index.md)는 daily 하위 경로가 없으므로 자연히 제외되지만,
//    명시적으로도 한 번 더 걸러냅니다.
const GROUP_PATTERN = /\/pages\/upj53\/([^/]+)\/daily\/[^/]+\.md$/;
const INDEX_SUFFIX = "/pages/upj53/index.md";

const groupMap = new Map<string, ArchivePost[]>();

for (const post of allPosts) {
  if (post.file?.endsWith(INDEX_SUFFIX)) continue;

  const match = post.file?.match(GROUP_PATTERN);
  if (!match) continue;

  const classId = match[1];
  const posts = groupMap.get(classId) ?? [];
  posts.push(post);
  groupMap.set(classId, posts);
}

interface TopicGroup {
  topic: string;
  posts: ArchivePost[];
}

// 3. 그룹(classId)은 역알파벳순(b.localeCompare(a))으로 정렬해 최신 그룹이 위로 오게 하고,
//    그룹 내부 문서는 date frontmatter 기준(없으면 파일명 기준) 역순으로 정렬합니다.
const topicGroups: TopicGroup[] = Array.from(groupMap.entries())
  .map(([topic, posts]) => ({
    topic,
    posts: posts.sort((a, b) => {
      const dateA = a.frontmatter?.date;
      const dateB = b.frontmatter?.date;
      if (dateA && dateB) return dateB.localeCompare(dateA);

      const fileA = a.file?.split("/").pop() ?? "";
      const fileB = b.file?.split("/").pop() ?? "";
      return fileB.localeCompare(fileA);
    }),
  }))
  .sort((a, b) => b.topic.localeCompare(a.topic));
---

<MainLayout title={frontmatter.title || "교사 전용 아카이브"}>
  <div class="mb-5 pt-4 border-bottom">
    <h1 class="fw-bold mb-3">{frontmatter.title}</h1>
    <div class="archive-intro">
      <slot />
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      {
        topicGroups.length > 0 ? (
          topicGroups.map((group) => (
            <section class="mb-5">
              <h2 class="h4 fw-bold mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                <span>📁 {group.topic}</span>
                <span class="badge bg-secondary rounded-pill">
                  {group.posts.length}
                </span>
              </h2>
              <div class="list-group">
                {group.posts.map((post) => (
                  <a
                    href={post.url}
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                  >
                    <span>
                      {post.frontmatter?.title ||
                        post.file?.split("/").pop()?.replace(".md", "")}
                    </span>
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">
                      문서
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        ) : (
          <p class="text-muted">등록된 아카이브 문서가 없습니다.</p>
        )
      }
    </div>
  </div>
</MainLayout>

<style>
  /* CLAUDE.md 테마 규칙: 하드코딩 색상 대신 Bootstrap 테마 변수를 사용합니다. */
  .archive-intro {
    color: var(--bs-body-color);
  }

  /* 사이트의 실제 다크모드 토글은 html.dark 클래스를 사용하지만,
     Bootstrap 5.3의 data-bs-theme="dark" 속성 환경에서도 동일하게 동작하도록
     두 선택자를 모두 대응합니다. */
  html.dark .badge.bg-primary-subtle,
  [data-bs-theme="dark"] .badge.bg-primary-subtle {
    background-color: rgba(13, 110, 253, 0.25) !important;
    color: #9ec5fe !important;
  }
</style>

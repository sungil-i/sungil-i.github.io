---
// src/components/YearSelector.astro
import { getClassEntries } from "../utils/classEntries";

const classEntries = getClassEntries();
const currentPath = Astro.url.pathname;
---

<div class="d-flex gap-2 align-items-center">
  <select
    id="class-switcher"
    class="form-select form-select-sm"
    aria-label="수업 선택"
  >
    <option
      value=""
      selected={!classEntries.some((e) => currentPath.startsWith(e.value))}
    >
      수업 선택
    </option>

    {
      classEntries.map((entry) => (
        <option
          value={entry.value}
          selected={currentPath.startsWith(entry.value)}
        >
          {entry.label}
        </option>
      ))
    }
  </select>

  <button
    id="class-move-btn"
    class="btn btn-sm btn-theme-adaptive text-nowrap flex-shrink-0"
    style="min-width:3rem;">Go</button
  >
</div>

<script>
  const switcher = document.getElementById("class-switcher");
  const moveBtn = document.getElementById("class-move-btn");

  if (switcher && moveBtn) {
    moveBtn.addEventListener("click", () => {
      const select = switcher as HTMLSelectElement;
      if (select.value !== "") {
        window.location.href = select.value;
      }
    });
  }
</script>
